#!/usr/bin/env bash
# Fargate stack ops: ECS Exec, admin URL, task IP, image update, stack delete.
#
# Usage:
#   ./deploy/fargate/ops exec
#   ./deploy/fargate/ops admin          # print http://<ip>:8081
#   ./deploy/fargate/ops admin --open   # also open in the browser (macOS)
#   ./deploy/fargate/ops ip
#   ./deploy/fargate/ops task
#   ./deploy/fargate/ops update-image   # roll to the newest vX.Y.Z on ghcr.io
#   ./deploy/fargate/ops delete         # delete the CloudFormation stack
#
# Defaults (override with flags or env):
#   --stack / RELAY_STACK / ENDCLOSE_RELAY_STACK  (default: endclose-relay)
#   --region / RELAY_REGION / AWS_REGION           (prompted if missing)
#   --container / RELAY_CONTAINER                 (default: relay)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="${ROOT}/cloudformation.yaml"
IMAGE_REPO='end-close/relay'
IMAGE_PREFIX='ghcr.io/end-close/relay'

STACK_DEFAULT='endclose-relay'
STACK="${RELAY_STACK:-${ENDCLOSE_RELAY_STACK:-$STACK_DEFAULT}}"
REGION="${RELAY_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-}}}"
CONTAINER="${RELAY_CONTAINER:-relay}"
IMAGE=''
OPEN_BROWSER=0
ASSUME_YES=0
CMD=''

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  exec              ECS Exec into the running task (/bin/sh)
  admin [--open]    Print admin UI URL (http://<private-ip>:8081)
  ip                Print the task private IPv4
  task              Print the running task ARN
  update-image      Roll to the newest vX.Y.Z on ghcr.io (VPC/subnets/cert/secret from the stack)
  delete [-y]       Delete the CloudFormation stack (EFS is retained)

Options:
  --stack NAME      CloudFormation / ECS cluster+service name (default: ${STACK_DEFAULT})
  --region REGION   AWS region (prompted if omitted)
  --container NAME  Container name (default: relay)
  --image URI|TAG   With update-image: skip GHCR lookup and deploy this image (tag or full URI)
  --open            With admin: open the URL (macOS \`open\`, else xdg-open)
  -y, --yes         With delete: skip confirmation prompt
  -h, --help        Show this help

Env defaults: RELAY_STACK, RELAY_REGION (or AWS_REGION), RELAY_CONTAINER
EOF
  exit "${1:-0}"
}

die() { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }

# Prompt on a TTY when a value is missing; fail clearly in non-interactive use.
ask() {
  local prompt="$1" value=''
  if [ ! -t 0 ]; then
    die "$2"
  fi
  printf '%s' "$prompt" >&2
  IFS= read -r value || true
  value="$(printf '%s' "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ -n "$value" ] || die "$2"
  printf '%s' "$value"
}

while [ $# -gt 0 ]; do
  case "$1" in
    exec|admin|ip|task|update-image|delete)
      [ -z "$CMD" ] || die "unexpected extra command: $1"
      CMD="$1"
      shift
      ;;
    --stack) STACK="$2"; shift 2 ;;
    --region) REGION="$2"; shift 2 ;;
    --container) CONTAINER="$2"; shift 2 ;;
    --image) IMAGE="$2"; shift 2 ;;
    --open) OPEN_BROWSER=1; shift ;;
    -y|--yes) ASSUME_YES=1; shift ;;
    -h|--help) usage 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

[ -n "$CMD" ] || usage 1
if [ -z "$REGION" ]; then
  REGION="$(ask 'AWS region: ' '--region is required (or set AWS_REGION / RELAY_REGION)')"
fi

need aws

running_task() {
  local arn
  arn="$(aws ecs list-tasks \
    --region "$REGION" \
    --cluster "$STACK" \
    --service-name "$STACK" \
    --desired-status RUNNING \
    --query 'taskArns[0]' \
    --output text)"
  if [ -z "$arn" ] || [ "$arn" = None ] || [ "$arn" = null ]; then
    die "no RUNNING task on cluster/service $STACK ($REGION)"
  fi
  printf '%s' "$arn"
}

task_private_ip() {
  local arn="$1" ip
  ip="$(aws ecs describe-tasks \
    --region "$REGION" \
    --cluster "$STACK" \
    --tasks "$arn" \
    --query 'tasks[0].attachments[0].details[?name==`privateIPv4Address`].value | [0]' \
    --output text)"
  if [ -z "$ip" ] || [ "$ip" = None ] || [ "$ip" = null ]; then
    die "could not resolve private IP for $arn"
  fi
  printf '%s' "$ip"
}

delete_stack() {
  local fs_id confirm=''
  if ! aws cloudformation describe-stacks --region "$REGION" --stack-name "$STACK" >/dev/null 2>&1; then
    die "stack not found: $STACK ($REGION)"
  fi
  fs_id="$(aws cloudformation describe-stacks \
    --region "$REGION" \
    --stack-name "$STACK" \
    --query 'Stacks[0].Outputs[?OutputKey==`FileSystemId`].OutputValue | [0]' \
    --output text 2>/dev/null || true)"
  if [ "$fs_id" = None ] || [ "$fs_id" = null ]; then
    fs_id=''
  fi

  cat >&2 <<EOF
About to delete CloudFormation stack:
  Stack:  $STACK
  Region: $REGION
EOF
  if [ -n "$fs_id" ]; then
    cat >&2 <<EOF
  EFS:    $fs_id  (DeletionPolicy=Retain — NOT deleted with the stack)
EOF
  else
    echo '  EFS:    (unknown — check for retained filesystems if you intended a full wipe)' >&2
  fi
  cat >&2 <<EOF

Secrets Manager secrets are also not deleted by this command.
EOF

  if [ "$ASSUME_YES" -ne 1 ]; then
    if [ ! -t 0 ]; then
      die 'refusing to delete without -y/--yes in non-interactive mode'
    fi
    printf 'Type the stack name (%s) to confirm: ' "$STACK" >&2
    IFS= read -r confirm || true
    [ "$confirm" = "$STACK" ] || die 'confirmation did not match — aborted'
  fi

  echo "→ deleting stack $STACK in $REGION" >&2
  aws cloudformation delete-stack --region "$REGION" --stack-name "$STACK"
  echo "→ waiting for delete to complete…" >&2
  if ! aws cloudformation wait stack-delete-complete --region "$REGION" --stack-name "$STACK"; then
    die "stack delete failed — check events: aws cloudformation describe-stack-events --region $REGION --stack-name $STACK"
  fi
  echo "deleted $STACK" >&2
  if [ -n "$fs_id" ]; then
    cat >&2 <<EOF
EFS $fs_id was retained. Delete it (and the secret) explicitly for a full wipe:
  aws efs delete-file-system --region $REGION --file-system-id $fs_id
EOF
  fi
}

# Highest vX.Y.Z from stdin (ignores "latest" and any other non-semver tags).
highest_semver_tag() {
  awk '
    BEGIN { bmaj=-1; bmin=0; bpat=0 }
    $0 ~ /^v[0-9]+\.[0-9]+\.[0-9]+$/ {
      ver=$0; sub(/^v/, "", ver)
      n=split(ver, a, ".")
      maj=a[1]+0; min=a[2]+0; pat=a[3]+0
      if (maj>bmaj || (maj==bmaj && min>bmin) || (maj==bmaj && min==bmin && pat>bpat)) {
        bmaj=maj; bmin=min; bpat=pat; best=$0
      }
    }
    END { if (best != "") print best }
  '
}

# Tags published to ghcr.io/end-close/relay. Anonymous registry token first;
# GitHub Packages API via `gh` if the package is private.
ghcr_version_tags() {
  local token json tags
  need curl
  token="$(curl -fsS "https://ghcr.io/token?service=ghcr.io&scope=repository:${IMAGE_REPO}:pull" 2>/dev/null \
    | jq -r '.token // empty' || true)"
  if [ -n "$token" ]; then
    json="$(curl -fsS -H "Authorization: Bearer ${token}" \
      "https://ghcr.io/v2/${IMAGE_REPO}/tags/list" 2>/dev/null || true)"
    tags="$(printf '%s' "$json" | jq -r '.tags[]?' 2>/dev/null || true)"
    if [ -n "$tags" ]; then
      printf '%s\n' "$tags"
      return 0
    fi
  fi
  if command -v gh >/dev/null; then
    gh api --paginate "orgs/End-Close/packages/container/relay/versions" \
      --jq '.[] | .metadata.container.tags[]?' 2>/dev/null && return 0
  fi
  return 1
}

resolve_image() {
  local tag
  if [ -n "$IMAGE" ]; then
    case "$IMAGE" in
      */*:*|*/*@*) ;; # full registry URI
      *:*) IMAGE="${IMAGE_PREFIX%/*}/$IMAGE" ;; # org/name:tag without registry
      *) IMAGE="${IMAGE_PREFIX}:$IMAGE" ;;
    esac
    return 0
  fi
  echo "→ looking up newest version on ghcr.io/${IMAGE_REPO}" >&2
  tag="$(ghcr_version_tags | highest_semver_tag || true)"
  [ -n "$tag" ] || die "could not list ghcr.io/${IMAGE_REPO} tags — pass --image ghcr.io/${IMAGE_REPO}:vX.Y.Z"
  IMAGE="${IMAGE_PREFIX}:${tag}"
}

# Reuse VPC, subnets, cert, secret, admin CIDR from the live stack; only Image changes
# (plus any template drift from cloudformation.yaml). EFS and secrets are untouched.
update_image() {
  local params_file running_image describe_err describe_rc
  [ -f "$TEMPLATE" ] || die "template not found: $TEMPLATE"
  need jq
  set +e
  describe_err="$(aws cloudformation describe-stacks --region "$REGION" --stack-name "$STACK" --query 'Stacks[0].StackStatus' --output text 2>&1)"
  describe_rc=$?
  set -e
  if [ "$describe_rc" -ne 0 ]; then
    echo "$describe_err" >&2
    case "$describe_err" in
      *expired*|*ExpiredToken*|*reauthenticate*)
        die "AWS session expired — run: aws login"
        ;;
      *"does not exist"*)
        die "stack not found: $STACK ($REGION) — create it first with ./deploy/fargate/deploy"
        ;;
      *)
        die "cannot load stack $STACK ($REGION)"
        ;;
    esac
  fi
  resolve_image
  params_file="$(mktemp)"
  trap 'rm -f "$params_file"' RETURN
  aws cloudformation describe-stacks \
    --region "$REGION" \
    --stack-name "$STACK" \
    --query 'Stacks[0].Parameters' --output json \
    | jq --arg image "$IMAGE" \
      'map(if .ParameterKey == "Image" then .ParameterValue = $image else . end)' \
    >"$params_file"
  running_image="$(aws cloudformation describe-stacks \
    --region "$REGION" \
    --stack-name "$STACK" \
    --query 'Stacks[0].Parameters[?ParameterKey==`Image`].ParameterValue | [0]' \
    --output text)"
  [ -n "$running_image" ] && [ "$running_image" != None ] || die "stack $STACK has no Image parameter"
  echo "→ updating $STACK in $REGION" >&2
  echo "   image: $running_image → $IMAGE" >&2
  set +e
  OUT="$(aws cloudformation update-stack \
    --region "$REGION" \
    --stack-name "$STACK" \
    --template-body "file://${TEMPLATE}" \
    --capabilities CAPABILITY_IAM \
    --parameters "file://${params_file}" 2>&1)"
  RC=$?
  set -e
  if [ "$RC" -ne 0 ]; then
    if echo "$OUT" | grep -qi 'No updates are to be performed'; then
      echo "→ already on $IMAGE (template unchanged)" >&2
      return 0
    fi
    echo "$OUT" >&2
    die "update-stack failed"
  fi
  echo "→ waiting for UPDATE_COMPLETE" >&2
  if ! aws cloudformation wait stack-update-complete --region "$REGION" --stack-name "$STACK"; then
    die "stack update failed — check events: aws cloudformation describe-stack-events --region $REGION --stack-name $STACK"
  fi
  echo "→ waiting for ECS service stable" >&2
  aws ecs wait services-stable \
    --region "$REGION" \
    --cluster "$STACK" \
    --services "$STACK"
  echo "updated $STACK → $IMAGE" >&2
}

case "$CMD" in
  task)
    running_task
    echo
    ;;
  ip)
    task_private_ip "$(running_task)"
    echo
    ;;
  admin)
    url="http://$(task_private_ip "$(running_task)"):8081"
    echo "$url"
    if [ "$OPEN_BROWSER" -eq 1 ]; then
      if command -v open >/dev/null; then
        open "$url"
      elif command -v xdg-open >/dev/null; then
        xdg-open "$url"
      else
        die "no browser opener found (install open/xdg-open, or copy the URL)"
      fi
    fi
    ;;
  exec)
    need session-manager-plugin
    arn="$(running_task)"
    echo "exec → $STACK / $arn ($CONTAINER)" >&2
    exec aws ecs execute-command \
      --region "$REGION" \
      --cluster "$STACK" \
      --task "$arn" \
      --container "$CONTAINER" \
      --interactive \
      --command '/bin/sh'
    ;;
  delete)
    delete_stack
    ;;
  update-image)
    update_image
    ;;
esac
