{
  "name": "@end-close/relay-app",
  "version": "0.0.0",
  "description": "The self-hosted End Close relay application: HTTP listeners, admin UI, operator CLI, metrics and telemetry around the @end-close/relay engine. The product version lives in the workspace root package.json.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:all": "mprocs",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "relayctl": "tsx src/cli/relayctl.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui"
  },
  "bin": {
    "relayctl": "./dist/cli/relayctl.js"
  },
  "dependencies": {
    "@end-close/relay": "workspace:*",
    "@end-close/relay-sqlite": "workspace:*",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.12.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "mprocs": "^0.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.6",
    "vitest": "^3.0.9"
  }
}
