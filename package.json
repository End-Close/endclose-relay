{
  "name": "endclose-relay",
  "version": "0.11.0",
  "description": "Self-hosted webhook relay for End Close: the application (apps/relay) and the embeddable engine it is built on (packages/*). This manifest carries the product version the release workflow bumps.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @endclose/relay-app dev",
    "dev:all": "pnpm build:packages && pnpm --filter @endclose/relay-app dev:all",
    "dev:ui": "pnpm --filter @endclose/relay-app dev:ui",
    "build": "pnpm build:packages && pnpm --filter @endclose/relay-app build",
    "build:packages": "pnpm -r --filter './packages/**' run build",
    "start": "pnpm --filter @endclose/relay-app start",
    "relayctl": "pnpm --filter @endclose/relay-app relayctl",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm --filter @endclose/relay-app typecheck && pnpm --filter @endclose/relay-examples typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
