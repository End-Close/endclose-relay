{
  "name": "@end-close/relay-sqlite",
  "version": "0.0.0",
  "description": "SQLite EventStore and ControlStore for @end-close/relay (rollback journal + synchronous=FULL; safe on network filesystems).",
  "keywords": [
    "endclose",
    "webhook",
    "relay",
    "sqlite",
    "better-sqlite3"
  ],
  "license": "MIT",
  "homepage": "https://github.com/End-Close/endclose-relay/tree/main/packages/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/End-Close/endclose-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/End-Close/endclose-relay.git",
    "directory": "packages/store-sqlite"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "peerDependencies": {
    "@end-close/relay": "workspace:^"
  },
  "devDependencies": {
    "@end-close/relay": "workspace:*",
    "@end-close/relay-store-contract": "workspace:*",
    "@types/better-sqlite3": "^7.6.12"
  }
}
